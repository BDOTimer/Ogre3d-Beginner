
material Christmas_Tree.fbxBark_mtl
{

    receive_shadows on

	technique
	{
		pass 
		{
            lighting on
            ambient 0.5 0.5 0.5 1.0
            diffuse 1.0 1.0 1.0 1.0
            specular 0.5 0.5 0.5 1.0 64

			texture_unit
			{
				texture bark.png
			}
		}

	}

}

