
material Cartoon_Desert_Skybox_2.fbxCartoon_Desert2 
{
	technique
	{
		pass 
		{
            lighting off
			depth_write off
            
            cull_hardware none  // Отключаем отсечение задних граней
            //cull_software none
            
            ambient 1
            diffuse 1 1 1 1
            specular 0 0 0 1 0

			texture_unit
			{
				texture Cartoon_Desert_6x-2.jpg
				//colour_op_ex add src_texture src_current
				//colour_op_multipass_fallback one one
                
                //tex_address_mode clamp
                //filtering anisotropic
                tex_address_mode clamp     // Важно для скайбокса
                filtering anisotropic      // Качество
                max_anisotropy 8
			}
		}
	}
}

