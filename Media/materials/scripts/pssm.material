material PSSM/shadow_caster
{
	technique
	{
		// all this will do is write depth
		pass
		{
			fog_override true none
			depth_bias -1 -1

			rtshader_system
			{
				lighting_stage gbuffer depth
			}
		}
	}
}

material Columns/ShadowCaster
{
    technique
    {
        pass
        {
            vertex_program_ref Columns/ShadowCasterVP
            {
                param_named_auto lightViewProjMatrix worldviewproj_matrix
                param_named normalOffset float 0.002  // ← настраиваемый параметр
            }
            fragment_program_ref Ogre/ShadowCasterFP {} // можно оставить стандартный
        }
    }
}

